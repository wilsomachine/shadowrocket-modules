[Rule]

# Standalone Shadowrocket module using the active configuration's PROXY policy.
# Give these rules priority over DIRECT modules and rules.
# Shared login, payment and telemetry hosts retain their existing routing.

# OpenAI / ChatGPT: service domains, API, authentication, assets and uploads.
DOMAIN-SUFFIX,openai.com,PROXY
DOMAIN-SUFFIX,chatgpt.com,PROXY
DOMAIN-SUFFIX,oaistatic.com,PROXY
DOMAIN-SUFFIX,oaiusercontent.com,PROXY
DOMAIN-SUFFIX,oaistatsig.com,PROXY
DOMAIN,cdn.openaimerge.com,PROXY
DOMAIN,o33249.ingest.us.sentry.io,PROXY

# Anthropic / Claude: service domains, API, platform and content bridge.
DOMAIN-SUFFIX,anthropic.com,PROXY
DOMAIN-SUFFIX,claude.ai,PROXY
DOMAIN-SUFFIX,claude.com,PROXY
DOMAIN-SUFFIX,claudeusercontent.com,PROXY
DOMAIN-SUFFIX,claude.app,PROXY
DOMAIN-SUFFIX,claudemcpcontent.com,PROXY

