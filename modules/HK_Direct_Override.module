#!name=HK Direct Override
#!desc=Rules:440 Created:2026-09-19 18:00:00 +08:00

[Rule]

# =========================================================
# SAFETY PRINCIPLE
# =========================================================
# This module aggressively DIRECTs services normally reachable in Hong Kong.
# It intentionally avoids broad shared-cloud rules (Cloudflare/AWS/Fastly IP ranges).
# OpenAI / ChatGPT / Anthropic / Claude are intentionally NOT added.
# Unknown domains fall through to the main config and therefore still hit FINAL,PROXY.


# =========================================================
# Hong Kong banking / payments / finance
# (extra coverage for services that also use non-.hk domains)
# =========================================================
# These explicit rules complement GEOIP,HK,DIRECT in the main config.
# They force DIRECT even when a Hong Kong service is delivered from an overseas CDN/IP.
DOMAIN-SUFFIX,hsbc.com.hk,DIRECT
DOMAIN-SUFFIX,hsbc.com,DIRECT
DOMAIN-SUFFIX,hangseng.com,DIRECT
DOMAIN-SUFFIX,bochk.com,DIRECT
DOMAIN-SUFFIX,sc.com,DIRECT
DOMAIN-SUFFIX,dbs.com,DIRECT
DOMAIN-SUFFIX,citibank.com,DIRECT
DOMAIN-SUFFIX,welab.bank,DIRECT
DOMAIN-SUFFIX,za.group,DIRECT
DOMAIN-SUFFIX,octopus.com,DIRECT
DOMAIN-SUFFIX,alipayhk.com,DIRECT
DOMAIN-SUFFIX,mpfa.org.hk,DIRECT
DOMAIN-SUFFIX,empf.org.hk,DIRECT
DOMAIN-SUFFIX,hkicl.com.hk,DIRECT

